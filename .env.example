# Copy this file to `.env` in the repo root before running docker compose.
#   cp .env.example .env        (bash)
#   Copy-Item .env.example .env (PowerShell)
#
# Every value below has a safe local-dev default baked into
# infra/docker/docker-compose.yml - you only need to change something here
# if a default port collides with something else already running on your
# machine, or before deploying anywhere beyond local dev.

# ---- General ---------------------------------------------------------
ENVIRONMENT=local

# ---- Postgres ----------------------------------------------------------
POSTGRES_USER=trustbuy
POSTGRES_PASSWORD=trustbuy_dev_password
POSTGRES_DB=trustbuy
# Host port. Chosen to avoid colliding with any other Postgres already
# running on 5432 (see DECISIONS.md - legacy project containers used it).
POSTGRES_PORT=5433

# ---- Redis ---------------------------------------------------------
REDIS_PORT=6380

# ---- ChromaDB ---------------------------------------------------------
CHROMA_PORT=8010

# ---- Service ports (host side) ---------------------------------------
AUTH_SERVICE_PORT=8091
CATALOG_SERVICE_PORT=8092
COMMUNITY_SERVICE_PORT=8093
GATEWAY_PORT=8090
WEB_PORT=3010

# ---- File storage (DECISIONS.md ADR-012) ---------------------------------------
# Leave TRUSTBUY_S3_BUCKET blank to store report attachments on local disk
# (a Docker volume) - fully working for local dev. Set it (+ AWS_REGION and
# real AWS credentials) to switch to S3 with zero code changes.
TRUSTBUY_S3_BUCKET=
AWS_REGION=
TRUSTBUY_LOCAL_STORAGE_PUBLIC_URL=http://localhost:8093/uploads

# ---- CORS ---------------------------------------------------------
# Comma-separated list of origins allowed to call the gateway/auth-service.
CORS_ALLOW_ORIGINS=http://localhost:3010

# ---- JWT (docs/SECURITY.md §1) ---------------------------------------
# Dev keypair is auto-generated into a shared Docker volume on first boot
# (trustbuy_auth/keys.py) - nothing to set here for local dev. In
# staging/production these paths point at files mounted from AWS Secrets
# Manager instead (ARCHITECTURE.md §8).
JWT_PRIVATE_KEY_PATH=/keys/private.pem
JWT_PUBLIC_KEY_PATH=/keys/public.pem
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# ---- LLM provider (DECISIONS.md ADR-010) ---------------------------------------
# Leave ANTHROPIC_API_KEY blank to run entirely on the free, deterministic
# MockLLMProvider (labeled [mock-llm] in every response it produces) - the
# rest of the platform works fully without this. Set a real key to switch
# the Evidence Fusion Engine's explanations and the AI Purchase Copilot to
# real Claude output, with zero code changes.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# ---- Frontend ---------------------------------------------------------
# What the browser calls. Must match GATEWAY_PORT above.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8090/api/v1
